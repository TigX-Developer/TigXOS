// cat.gl — print file to stdout
fn main() {
    if argc < 2 {
        print("usage: cat FILE")
        exit(1)
    }
    let fd = open(argv[1], O_RDONLY)
    if fd < 0 {
        print("cat: cannot open", argv[1])
        exit(1)
    }
    while 1 {
        let c = readch(fd)
        if c < 0 {
            break
        }
        writech(STDOUT, c)
    }
    close(fd)
    exit(0)
}
