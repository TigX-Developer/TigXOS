// tee.gl — copy stdin to stdout and FILE
fn main() {
    if argc < 2 {
        print("usage: tee FILE")
        exit(1)
    }
    let fd = open(argv[1], O_WRONLY + O_CREAT + O_TRUNC)
    if fd < 0 {
        print("tee: cannot open", argv[1])
        exit(1)
    }
    while 1 {
        let c = readch(STDIN)
        if c < 0 {
            break
        }
        writech(STDOUT, c)
        writech(fd, c)
    }
    close(fd)
    exit(0)
}
