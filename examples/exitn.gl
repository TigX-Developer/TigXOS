// exitn.gl — exit with code from argv[1] (default 0). Demo for 1.0.66.
fn main() {
    let code = 0
    if argc >= 2 {
        // tiny atoi
        let i = 0
        let s = argv[1]
        let neg = 0
        if s[0] == '-' {
            neg = 1
            i = 1
        }
        while i < len(s) {
            let c = s[i]
            if c >= '0' {
                if c <= '9' {
                    code = code * 10 + (c - '0')
                }
            }
            i = i + 1
        }
        if neg == 1 {
            code = 0 - code
        }
    }
    exit(code)
}
