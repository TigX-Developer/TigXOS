// typed.gl — Green Lizard 2 demo
fn add(a: int, b: int) -> int {
    return a + b
}

fn is_pos(x: int) -> bool {
    return x > 0
}

fn main() {
    let n: int = 10
    let ok: bool = true
    let name: str = "Tig"
    let sum: int = add(n, 32)
    print("sum =", sum)
    print("name =", name)
    if is_pos(sum) {
        print("positive")
    }
    let label: str = sum as str
    print("as str:", label)
    let flag: bool = 0 as bool
    if !flag {
        print("flag was false")
    }
    if ok {
        print("ok")
    }
    exit(0)
}
